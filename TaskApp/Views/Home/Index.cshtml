@{
    ViewBag.Title = "Home Page";
}

<div class="text-center">
    <h1>
        Gestión de Tareas
    </h1>

    <p class="text-muted">
        Administra tus tareas
    </p>

    <br />
</div>

<div>
    <button type="button" class="btn btn-primary pull-right" data-toggle="modal" data-target="#createUpdateTicket">
        Nuevo
        <span class="glyphicon glyphicon-plus-sign"></span>
    </button>

    <br />
    <br />
    <br />
</div>

<div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead>
                <tr class="bg-primary">
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>RFN-01</td>
                    <td>Revisión de pruebas funcionales de requerimiento 01</td>
                    <td>
                        <span class="label label-warning">Pendiente</span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-warning">
                            <span class="glyphicon glyphicon-pencil"></span>
                            Editar
                        </button>

                        <button type="button" class="btn btn-danger">
                            <span class="glyphicon glyphicon-trash"></span>
                            Eliminar
                        </button>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>RFN-37</td>
                    <td>Revisión de pruebas funcionales de requerimiento 37</td>
                    <td>
                        <span class="label label-success">Completada</span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-warning">
                            <span class="glyphicon glyphicon-pencil"></span>
                            Editar
                        </button>

                        <button type="button" class="btn btn-danger">
                            <span class="glyphicon glyphicon-trash"></span>
                            Eliminar
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createUpdateTicket">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"> 
                     <span class="glyphicon glyphicon-remove-sign"></span>
                </button>

                <h4 class="modal-title">Agregar/Editar tarea</h4>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" placeholder="Ingrese el nombre" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Descripción</label>
                    <textarea rows="5" placeholder="Ingrese la descripción" class="form-control"></textarea>
                </div>

                <div class="form-group">
                    <label>Estado</label>
                    <select class="form-control">
                        <option value="1" select>Pendiente</option>
                        <option value="2">Completado</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary">
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>