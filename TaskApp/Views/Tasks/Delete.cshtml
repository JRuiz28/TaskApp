@model TaskApp.Models.Task

@{
    ViewBag.Title = "Delete";
}

<div class="text-center">
    <h1>
        Eliminar Tarea
    </h1>

    <p class="text-danger">
        ¿Estas seguro que quiere eliminar la tarea?
    </p>

    <br />
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color text-center">

        <a href="@Url.Action("Index")" class="btn btn-primary" title="Volver a gestión de tareas">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Cancelar
        </a>

        <input type="submit" value="Confirmar eliminación" class="btn btn-danger" />

    </div>
}
<br />

<div>
    <dl class="dl-horizontal">
        <dt>
            Nombre
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt>
            Descripción
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt>
            Estado
        </dt>

        <dd>
            @Html.DisplayFor(model => model.State)
        </dd>
    </dl>
</div>
