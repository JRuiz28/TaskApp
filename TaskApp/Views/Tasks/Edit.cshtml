@model TaskApp.Models.Task

@{
    ViewBag.Title = "Edit";
}

<div>
    <a href="@Url.Action("Index")" class="btn btn-primary" title="Volver a gestión de tareas">
        <span class="glyphicon glyphicon-arrow-left"></span>
        Volver a gestión de tareas
    </a>
</div>

<div class="text-center">
    <h1>
        Editar Tarea
    </h1>

    <p class="text-muted">
        Edite tu propia tarea
    </p>

    <br />
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <div class="form-group">
            <label for="Name" class="control-label col-md-2">Nombre:</label>

            <div class="col-md-10">
                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label for="Description" class="control-label col-md-2">Descripción:</label>

            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label for="State" class="control-label col-md-2">Estado:</label>

            <div class="col-md-10">
                @Html.DropDownListFor(
                    model => model.State,
                    new SelectList(new[]
                    {
                        new { Value = "Pendiente", Text = "Pendiente" },
                        new { Value = "Completado", Text = "Completado" }
                    }, "Value", "Text"),
                    new { @class = "form-control" }
                )
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar" class="btn btn-info" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
