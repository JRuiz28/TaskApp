
@{
    ViewBag.Title = "Index";
}

<div class="text-center">
    <h1>
        Gestión de Tareas
    </h1>

    <p class="text-muted">
        Administra tus tareas
    </p>

    <br />
</div>

<div>
    <a href="@Url.Action("Create")" class="btn btn-primary pull-right" title="Nuevo">
        Nuevo
        <span class="glyphicon glyphicon-plus-sign"></span>
    </a>

</div>

<div>
    <h3>Filtro por estado</h3>
    <label><input type="radio" name="filter" value="Todos" checked /> Todos</label>
    <label><input type="radio" name="filter" value="Pendiente" /> Pendiente</label>
    <label><input type="radio" name="filter" value="Completado" /> Completado</label>

    <button type="button" id="btn-refresh" class="btn btn-info">
        <span class="glyphicon glyphicon-refresh"></span>
        Actualizar
    </button>
</div>

<div id="task-table"></div>

@section scripts {
    <script>
        $(function () {
            var listUrl = '@Url.Action("List")';

            function loadTasks() {
                var filter = $('input[name="filter"]:checked').val();

                $.ajax({
                    url: listUrl,
                    type: 'GET',
                    cache: false,
                    data: { filter: filter }
                })
                .done(function (html) {
                    $('#task-table').html(html);
                })
                .fail(function () {
                    alert('No se pudo cargar la lista de tareas.');
                });
            }

            $('#btn-refresh').on('click', loadTasks);
            $('input[name="filter"]').on('change', loadTasks);

            loadTasks();
        });
    </script>
}