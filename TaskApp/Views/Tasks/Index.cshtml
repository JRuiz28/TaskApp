@model IEnumerable<TaskApp.Models.Task>

@{
    ViewBag.Title = "Index";
    string filter = ViewBag.Filter as string ?? "Todos";
}

<div class="text-center">
    <h1>
        Gestión de Tareas
    </h1>

    <p class="text-muted">
        Administra tus tareas
    </p>

    <br />
</div>

<div>
    <a href="@Url.Action("Create")" class="btn btn-primary pull-right" title="Nuevo">
        Nuevo
        <span class="glyphicon glyphicon-plus-sign"></span>
    </a>

</div>

<div>
    <h3>Filtro por estado</h3>
    @using (Html.BeginForm("Index", "Tasks", FormMethod.Get))
    {
        <label>@Html.RadioButton("filter", "Todos", filter == "Todos", new { onchange = "this.form.submit()" }) Todos</label>
        <label>@Html.RadioButton("filter", "Pendiente", filter == "Pendiente", new { onchange = "this.form.submit()" }) Pendiente</label>
        <label>@Html.RadioButton("filter", "Completado", filter == "Completado", new { onchange = "this.form.submit()" }) Completado</label>
    }
</div>

<div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead>
                <tr class="bg-primary">
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Creado en</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.State)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedIn)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-warning" title="Editar">
                                <span class="glyphicon glyphicon-pencil"></span>
                                Editar
                            </a>

                            <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-danger" title="Eliminar">
                                <span class="glyphicon glyphicon-trash"></span>
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
